model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures

expression DataFolder = "C:\path\to\supply-chain-olist\data\powerbi" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

ref table fact_orders
ref table dim_date
ref table dim_seller
ref table dim_route
ref table dim_category
ref table dim_distance_band
ref table scenario_assumptions

ref relationship 'Orders — Date'
ref relationship 'Orders — Seller'
ref relationship 'Orders — Route'
ref relationship 'Orders — Category'
ref relationship 'Orders — Distance'
